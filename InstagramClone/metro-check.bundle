    username: {
      color: '#000',
      fontWeight: 'bold',
      fontSize: 16
    },
    name: {
      color: '#333'
    },
    followers: {
      color: '#555',
      fontSize: 12
    },
    emptyText: {
      color: '#000',
      textAlign: 'center',
      marginTop: 20
    },
    cameraText: {
      fontSize: 16,
      color: '#000',
      textAlign: 'center',
      marginBottom: 10
    },
    closeCameraButton: {
      padding: 10,
      backgroundColor: '#000',
      alignItems: 'center',
      borderRadius: 5
    },
    closeCameraText: {
      color: '#fff',
      fontSize: 14
    }
  });
